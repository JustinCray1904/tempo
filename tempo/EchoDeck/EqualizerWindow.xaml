<Window x:Class="EchoDeck.EqualizerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource EchoWindow}" Title="Equaliser" Width="620" Height="420" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Grid Grid.Row="0">
            <TextBlock Text="Equaliser" Style="{StaticResource PageTitle}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="Off" Style="{StaticResource HintText}" Margin="0,0,8,0"/>
                <CheckBox x:Name="EqToggle" Style="{StaticResource SwitchToggle}" Click="EqToggle_Click"/>
                <TextBlock Text="On" Style="{StaticResource HintText}" Margin="8,0,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Preset Combo -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,20">
            <TextBlock Text="Preset" Style="{StaticResource RowLabel}" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <ComboBox x:Name="PresetCombo" Style="{StaticResource EchoCombo}" Width="180" SelectionChanged="PresetCombo_SelectionChanged"/>
        </StackPanel>

        <!-- Sliders -->
        <Grid Grid.Row="2" x:Name="SliderHost">
            <!-- Sliders are generated dynamically in code-behind based on LibVLC's band count -->
        </Grid>

        <!-- Footer Options -->
        <CheckBox Grid.Row="3" x:Name="LinkSlidersCheck" Content="Move nearby sliders together" Style="{StaticResource SelectionCheckbox}" Margin="0,20,0,20" HorizontalAlignment="Left" IsChecked="True"/>
        
        <!-- Close Button -->
        <Button Grid.Row="4" Content="Close" Style="{StaticResource FlatButton}" Width="120" HorizontalAlignment="Center" Click="Close_Click"/>
    </Grid>
</Window>