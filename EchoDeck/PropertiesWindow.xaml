<Window x:Class="EchoDeck.PropertiesWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource EchoWindow}" Title="Properties" Width="520" Height="500" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Properties" Style="{StaticResource PageTitle}" Margin="0,0,0,20"/>
        
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Title" Style="{StaticResource HintText}"/>
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="PropTitle" Style="{StaticResource RowLabel}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                <TextBlock Grid.Row="1" Text="Artist" Style="{StaticResource HintText}"/>
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="PropArtist" Style="{StaticResource RowLabel}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                <TextBlock Grid.Row="2" Text="Album" Style="{StaticResource HintText}"/>
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="PropAlbum" Style="{StaticResource RowLabel}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                <TextBlock Grid.Row="3" Text="Genre" Style="{StaticResource HintText}"/>
                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="PropGenre" Style="{StaticResource RowLabel}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                <TextBlock Grid.Row="4" Text="Year" Style="{StaticResource HintText}"/>
                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="PropYear" Style="{StaticResource RowLabel}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                <TextBlock Grid.Row="5" Text="Length" Style="{StaticResource HintText}"/>
                <TextBlock Grid.Row="5" Grid.Column="1" x:Name="PropLength" Style="{StaticResource RowLabel}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                <TextBlock Grid.Row="6" Text="Resolution" Style="{StaticResource HintText}"/>
                <TextBlock Grid.Row="6" Grid.Column="1" x:Name="PropResolution" Style="{StaticResource RowLabel}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                <TextBlock Grid.Row="7" Text="Item type" Style="{StaticResource HintText}"/>
                <TextBlock Grid.Row="7" Grid.Column="1" x:Name="PropType" Style="{StaticResource RowLabel}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                <TextBlock Grid.Row="8" Text="File location" Style="{StaticResource HintText}"/>
                <TextBlock Grid.Row="8" Grid.Column="1" x:Name="PropLocation" Style="{StaticResource RowLabel}" TextWrapping="Wrap" Margin="0,0,0,12"/>
            </Grid>
        </ScrollViewer>
        
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Open file location" Style="{StaticResource FlatButton}" Margin="0,0,12,0" Click="OpenLocation_Click"/>
            <Button Content="Close" Style="{StaticResource AccentButton}" Width="100" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>