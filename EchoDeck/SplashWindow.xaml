<Window x:Class="EchoDeck.SplashWindow" 
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
        Title="Tempo" Width="400" Height="300" 
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" 
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False" Topmost="True">
    <Border Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource SlateBrush}" BorderThickness="1" CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.6" Color="Black"/>
        </Border.Effect>
        <Grid>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Tempo" FontSize="48" FontWeight="Black" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,8">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="TitleTransform"/>
                    </TextBlock.RenderTransform>
                </TextBlock>
                <TextBlock Text="Music &amp; Video Player" FontSize="14" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Loading environment..." FontSize="11" Foreground="{DynamicResource Fg3Brush}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20"/>
        </Grid>
    </Border>
</Window>